{
    "name": "islamkabbary/statamic-audit-log",
    "description": "Detailed audit log for the Statamic control panel: who changed what, from what, to what, and when. File-based (no database), with a CP screen under Tools › Audit Log. Supports Statamic 4/5/6 on Laravel 10-13.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "audit",
        "audit-log",
        "activity-log"
    ],
    "authors": [
        {
            "name": "Islam Kabbary",
            "email": "islamkabbary@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "statamic/cms": "^4.0 || ^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "IslamKabbary\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IslamKabbary\\AuditLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IslamKabbary\\AuditLog\\ServiceProvider"
            ]
        },
        "statamic": {
            "name": "Audit Log",
            "description": "Who changed what in the control panel, from what, to what, and when."
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
